        <param-value>smtp.gmail.com</param-value>
    </context-param>
    <context-param>
        <param-name>smtp.port</param-name>
        <param-value>587</param-value>
    </context-param>
    <context-param>
        <param-name>smtp.username</param-name>
        <param-value>leloyal6767@gmail.com</param-value>
    </context-param>
    <context-param>
        <param-name>smtp.password</param-name>
        <param-value>ckuv mujo elut njbp</param-value>
    </context-param>
    <context-param>
        <param-name>smtp.from</param-name>
        <param-value>leloyal6767@gmail.com</param-value>
    </context-param>
    <context-param>
        <param-name>smtp.fromName</param-name>
        <param-value>Le Royal Restaurant</param-value>
    </context-param>

    <context-param>
        <param-name>vnpay.payUrl</param-name>
        <param-value>https://sandbox.vnpayment.vn/paymentv2/vpcpay.html</param-value>
    </context-param>
    <context-param>
        <param-name>vnpay.tmnCode</param-name>
        <param-value>ZWEPHG99</param-value>
    </context-param>
    <context-param>
        <param-name>vnpay.hashSecret</param-name>
        <param-value>20IWS6I72EY3GDSG10W8GVKV1UUFF9NG</param-value>
    </context-param>
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- App Context Listener -->
    <listener>
        <listener-class>filter.AppContextListener</listener-class>
    </listener>

    <!-- Filters declared in XML only, as required by MVC-V2 plan -->
    <filter>
        <filter-name>RememberMeFilter</filter-name>
        <filter-class>filter.RememberMeFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RememberMeFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>HolidaySurchargeNotifyFilter</filter-name>
        <filter-class>filter.HolidaySurchargeNotifyFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>HolidaySurchargeNotifyFilter</filter-name>
        <url-pattern>/MainController</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/staff/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/customer/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/MainController</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/BookingController</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/booking.jsp</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>RoleFilter</filter-name>
        <filter-class>filter.RoleFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/staff/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/customer/*</url-pattern>
    </filter-mapping>

    <!-- FrontController Servlet -->
    <servlet>
        <servlet-name>MainController</servlet-name>
        <servlet-class>controller.MainController</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>6291456</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>MainController</servlet-name>
        <url-pattern>/MainController</url-pattern>
    </servlet-mapping>

    <!-- Sub Controllers -->
    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>controller.LoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/LoginController</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>controller.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/HomeController</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MenuController</servlet-name>
        <servlet-class>controller.MenuController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MenuController</servlet-name>
        <url-pattern>/MenuController</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookingController</servlet-name>
        <servlet-class>controller.BookingController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingController</servlet-name>
        <url-pattern>/BookingController</url-pattern>
    </servlet-mapping>

    <!-- Admin Controllers -->
    <servlet>
        <servlet-name>AdminRankConfigController</servlet-name>
        <servlet-class>controller.admin.AdminRankConfigController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminRankConfigController</servlet-name>
        <url-pattern>/admin/rank-config</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserController</servlet-name>
        <servlet-class>controller.admin.AdminUserController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserController</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <!-- Customer Controllers -->
    <servlet>
        <servlet-name>CustomerRankController</servlet-name>
        <servlet-class>controller.customer.CustomerRankController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerRankController</servlet-name>
        <url-pattern>/customer/rank</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NotificationController</servlet-name>
        <servlet-class>controller.customer.NotificationController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationController</servlet-name>
        <url-pattern>/customer/notifications</url-pattern>
    </servlet-mapping>

    <!-- VNPay Controller -->
    <servlet>
        <servlet-name>VnPayController</servlet-name>
        <servlet-class>controller.payment.VnPayController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VnPayController</servlet-name>
        <url-pattern>/payment/vnpay-pay</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VnPayController</servlet-name>
        <url-pattern>/payment/vnpay-return</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VnPayController</servlet-name>
        <url-pattern>/payment/vnpay-ipn</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AdminRestaurantController</servlet-name>
        <servlet-class>controller.AdminRestaurantController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminRestaurantController</servlet-name>
        <url-pattern>/AdminRestaurantController</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RestaurantApiController</servlet-name>
        <servlet-class>controller.RestaurantApiController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RestaurantApiController</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>MainController</welcome-file>
    </welcome-file-list>
</web-app>
